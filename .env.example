# Django Secret Key (generate a secure random string in production)
DJANGO_SECRET_KEY=django-insecure-mou-management-dev-key-change-in-production

# Debug Mode (set to False in production)
DJANGO_DEBUG=True

# Allowed Hosts (comma-separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database URL
# Default SQLite: sqlite:///db.sqlite3
# Production PostgreSQL (Neon / Supabase): postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# Google Gemini API Key (Get a 100% free key from https://aistudio.google.com)
GEMINI_API_KEY=

# Email Settings (Optional - console backend used by default for local development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For Resend / SMTP in production:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=your_resend_api_key
# DEFAULT_FROM_EMAIL=mou-system@yourdomain.com
